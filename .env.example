# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Path to the SQLite database file used by the Drizzle-backed
# governance layer (trips/predictions/recommendations/audit log). Defaults to
# ./database/masara.db if unset. Swapping to Postgres/Supabase later only
# requires changing this to a postgres:// connection string plus the driver
# in database/client.ts.
DATABASE_URL="./database/masara.db"

# AI_MODE: 'mock' (default) runs the full detect->predict->recommend loop
# deterministically with zero API keys. Set to 'gemini' to use GEMINI_API_KEY.
AI_MODE="mock"

# Phase 5C — Notification delivery channels. Each is unset/false by default,
# meaning the channel is SKIPPED, never SUCCESS: in-app notifications
# (Phase 5B) work fully regardless of any of these. No real push/SMS/email
# vendor is integrated in this codebase yet — setting *_ENABLED="true"
# without also configuring a real vendor SDK still results in an honest
# UNAVAILABLE outcome, never a fabricated "delivered" status (see
# server/services/PushNotificationProvider.ts, SmsNotificationProvider.ts,
# EmailNotificationProvider.ts).
NOTIFICATION_PUSH_ENABLED="false"
PUSH_PROVIDER_API_KEY=""

NOTIFICATION_SMS_ENABLED="false"
SMS_PROVIDER_API_KEY=""

NOTIFICATION_EMAIL_ENABLED="false"
EMAIL_PROVIDER_API_KEY=""
